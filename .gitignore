# ===========================
# AI WorkHub - Git Ignore
# 忽略本地个人文件和临时文件
# ===========================

# -----------------------
# 依赖 (不要提交)
# -----------------------
node_modules/
.pnp/
.pnp.js

# -----------------------
# 构建输出 (自动生成)
# -----------------------
dist/
dist-electron/
release/
*.exe
*.dmg
*.msi
*.deb
*.rpm
*.zip

# -----------------------
# IDE 和编辑器
# -----------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# -----------------------
# 日志和缓存
# -----------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------
# 环境变量 (包含敏感信息)
# -----------------------
.env
.env.local
.env.*.local

# -----------------------
# 测试
# -----------------------
coverage/
.nyc_output/

# -----------------------
# 临时文件
# -----------------------
*.tmp
*.temp
.cache/
tmp/

# -----------------------
# Electron 相关
# -----------------------
.electron/
electron_binary/
*.asar

# -----------------------
# Windows 系统文件
# -----------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------
# 应用数据 (包含 API 密钥等个人数据)
# -----------------------
# 注意: 不要提交包含敏感信息的本地数据
# 实际路径: %APPDATA%/ai-workhub/
*.json
!package-lock.json
!tsconfig.json

# -----------------------
# ZCode 配置 (包含计划模式等)
# -----------------------
.zcode/
!.zcode/plans/

# -----------------------
# 开发调试文件
# -----------------------
*.local

# -----------------------
# 个人脚本
# -----------------------
*.bat
*.cmd
*.ps1

# -----------------------
# 本地开发文档（不提交到 GitHub）
# -----------------------
TODO.md
USER_JOURNEY.md
